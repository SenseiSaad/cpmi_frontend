# Production build settings for Vercel. PUBLIC values only — never put secrets here:
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Variables set in the Vercel dashboard with the same name override these.

# The browser calls same-origin /api/*; Next.js forwards it to the backend so the session
# and CSRF cookies stay first-party (the two vercel.app hosts are different sites).
NEXT_PUBLIC_API_BASE_URL=
BACKEND_ORIGIN=https://cpmi-backend.vercel.app
NEXT_PUBLIC_ENVIRONMENT=production
